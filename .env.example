DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# google | vertex | mock
AI_PROVIDER=mock
GOOGLE_API_KEY=
AI_MODEL_FAST=
AI_MODEL_STRONG=
# Уровень размышлений (minimal|low|medium|high), только для моделей, которые его поддерживают
AI_THINKING_FAST=
AI_THINKING_STRONG=
PORT=8787

# Frontend (apps/web, Vite reads this root .env; only VITE_* reach the browser)
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=$SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=$SUPABASE_PUBLISHABLE_KEY
