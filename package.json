{
  "name": "sana",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @sana/api dev",
    "dev:web": "pnpm --filter @sana/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "db:start": "DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock supabase start",
    "db:stop": "DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock supabase stop",
    "db:status": "DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock supabase status",
    "db:generate": "pnpm --filter @sana/api db:generate",
    "db:migrate": "pnpm --filter @sana/api db:migrate",
    "seed": "pnpm --filter @sana/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "supabase": "3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
